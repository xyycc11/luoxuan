# 复制为本目录私有.env；不要提交真实密钥。
# --offline忽略模型/Redis/Milvus开关；模板模式不产生API费用。
ECHOWORLD_NPC_MODE=template
ECHOWORLD_NARRATION_MODE=template
ECHOWORLD_LLM_MODEL=deepseek-flash
ECHOWORLD_LLM_API_KEY=
ECHOWORLD_QWEN_EMBEDDING_KEY=
ECHOWORLD_EMBEDDING_REGION=cn
ECHOWORLD_REDIS_URL=
ECHOWORLD_MILVUS_URI=
ECHOWORLD_MILVUS_TOKEN=
# 可选：演示固定seed，保留则便于复现；删掉此行使用随机seed。
# ECHOWORLD_DEMO_SEED=2
# 默认本目录data/echoworld.sqlite3；文件SQL配套自动生成.checkpoints.sqlite3。
# ECHOWORLD_DATABASE_URL=sqlite+pysqlite:///C:/absolute/path/game.sqlite3
# 非SQLite存档必须额外指定本机checkpoint文件；PostgreSQL整链尚未验收。
# ECHOWORLD_CHECKPOINT_PATH=C:/absolute/path/graph.sqlite3
